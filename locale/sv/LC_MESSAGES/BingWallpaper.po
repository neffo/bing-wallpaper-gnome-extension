#: ui/prefsadw.ui.h:1 extension.js:136
msgid "Settings"
msgstr "Inställningar"

#: ui/prefsadw.ui.h:2
msgid "Indicator"
msgstr "Indikator"

#: ui/prefsadw.ui.h:3
msgid "Hide Indicator"
msgstr "Dölj indikatorn"

#: ui/prefsadw.ui.h:4
msgid "Whether to hide the panel indicator"
msgstr "Om indikatorn i panelen ska döljas"

#: ui/prefsadw.ui.h:5
msgid "Desktop notifications"
msgstr "Skrivbordsaviseringar"

#: ui/prefsadw.ui.h:6
msgid "Enable notifications on new images"
msgstr "Aktivera aviseringar om nya bilder"

#: ui/prefsadw.ui.h:7
msgid "Indicator icon"
msgstr "Indikatorikon"

#: ui/prefsadw.ui.h:8
msgid "Select from alternate tray icons"
msgstr "Välj bland alternativa ikoner"

#: ui/prefsadw.ui.h:9
msgid "Wallpaper"
msgstr "Bakgrundsbild"

#: ui/prefsadw.ui.h:10
msgid "Set wallpaper"
msgstr "Ange bakgrundsbild"

#: ui/prefsadw.ui.h:11
msgid "Whether to set wallpaper automatically"
msgstr "Om bakgrundsbilden ska anges automatiskt"

#: ui/prefsadw.ui.h:12
msgid "Shuffle wallpaper"
msgstr "Blanda bakgrundsbilder"

#: ui/prefsadw.ui.h:13
msgid "Randomly select wallpaper from collection"
msgstr "Välj en slumpmässig bakgrundsbild från samlingen"

#: ui/prefsadw.ui.h:14
msgid "Shuffle interval"
msgstr "Blandningsintervall"

#: ui/prefsadw.ui.h:15
msgid "How frequently to shuffle wallpapers"
msgstr "Hur ofta bakgrundsbilderna ska blandas"

#: ui/prefsadw.ui.h:16
msgid "Downloads"
msgstr "Nedladdningar"

#: ui/prefsadw.ui.h:17
msgid "Download folder"
msgstr "Nedladdningsmapp"

#: ui/prefsadw.ui.h:18
msgid "Open or change wallpaper downloads folder"
msgstr "Öppna eller ändra mappen för nedladdade bakgrundsbilder"

#: ui/prefsadw.ui.h:19
msgid "Debug"
msgstr "Felsökning"

#: ui/prefsadw.ui.h:20
msgid "Debug options"
msgstr "Felsökningsalternativ"

#: ui/prefsadw.ui.h:21
msgid "Debug logging"
msgstr "Felsökningsloggning"

#: ui/prefsadw.ui.h:22
msgid "Enable logging to system journal"
msgstr "Aktivera loggning till systemjournalen"

#: ui/prefsadw.ui.h:23
msgid "Advanced options"
msgstr "Avancerade alternativ"

#: ui/prefsadw.ui.h:24 extension.js:150
msgid "Always show new images"
msgstr "Visa alltid nya bilder"

#: ui/prefsadw.ui.h:25
msgid "Switch to new images when available (unless on random mode)"
msgstr "Byt till ny bild när tillgänglig (om inte i slumpmässigt läge)"

#: ui/prefsadw.ui.h:26
msgid "Purge on trash"
msgstr "Radera helt vid borttagning"

#: ui/prefsadw.ui.h:27
msgid "Trashing an image will remove it from database and disk"
msgstr "Om du tar bort en bild raderas den från databasen och disken"

#: ui/prefsadw.ui.h:28
msgid "Screen resolution"
msgstr "Skärmupplösning"

#: ui/prefsadw.ui.h:29
msgid "Override automatic resolution selection"
msgstr "Åsidosätt automatiskt skärmupplösningsval"

#: ui/prefsadw.ui.h:30
msgid "Random interval"
msgstr "Slumpmässigt intervall"

#: ui/prefsadw.ui.h:31 ui/prefsadw.ui.h:39
msgid "Custom shuffle interval when enabled"
msgstr "Anpassat blandningsintervall när aktiverat"

#: ui/prefsadw.ui.h:32
msgid "Delete older images"
msgstr "Ta bort äldre bilder"

#: ui/prefsadw.ui.h:33
msgid "Automatically delete older images (excludes favourites)"
msgstr "Ta bort äldre bilder automatiskt (gäller inte favoriter)"

#: ui/prefsadw.ui.h:34
msgid "Number of days to keep images"
msgstr "Antal dagar att behålla bilder"

#: ui/prefsadw.ui.h:35
msgid "Keep images for this number of days (favourites are kept forever)"
msgstr "Behåll bilder i så här många dagar (favoriter behålls för alltid)"

#: ui/prefsadw.ui.h:36
msgid "Always export Bing data"
msgstr "Exportera alltid Bing-data"

#: ui/prefsadw.ui.h:37
msgid "Export Bing JSON when image data changes"
msgstr "Exportera Bing-JSON när bilddata ändras"

#: ui/prefsadw.ui.h:38
msgid "Bing JSON data"
msgstr "Bing JSON-data"

#: ui/prefsadw.ui.h:40
msgid "About"
msgstr "Om"

#: ui/prefsadw.ui.h:41
msgid "Bing Wallpaper"
msgstr "Bing-bakgrundsbild"

#: ui/prefsadw.ui.h:42
msgid "New wallpaper images everyday from Bing"
msgstr "Dagliga skrivbordsbakgrundsbilder från Bing"

#: ui/prefsadw.ui.h:43
msgid "Maintained by Michael Carroll"
msgstr "Underhålls av Michael Carroll"

#: ui/prefsadw.ui.h:44
msgid "Version"
msgstr "Version"

#: ui/prefsadw.ui.h:45
msgid "Release notes"
msgstr "Versionsfakta"

#: ui/prefsadw.ui.h:46
msgid "GNOME extensions page"
msgstr "Sidan på GNOME-tillägg"

#: ui/prefsadw.ui.h:47
msgid "Source code"
msgstr "Källkod"

#: ui/prefsadw.ui.h:48
msgid "Report an issue"
msgstr "Rapportera ett problem"

#: ui/prefsadw.ui.h:49
msgid "Contributors"
msgstr "Bidragsgivare"

#: ui/prefsadw.ui.h:50
msgid "License"
msgstr "Licens"

#: ui/prefsadw.ui.h:51
msgid ""
"This extension is free software: you can redistribute it and/or modify it "
"under the terms of the GNU Lesser General Public License as published by the "
"Free Software Foundation, either version 3 of the License, or (at your "
"option) any later version."
msgstr ""
"Detta tillägg är fri programvara: du kan distribuera det vidare och/eller "
"ändra det under villkoren i GNU Lesser General Public License, publicerad av "
"Free Software Foundation, antingen version 3 av licensen eller (om du så "
"vill) en senare version."

#: ui/prefsadw.ui.h:52 prefs.js:103
msgid "Change folder"
msgstr "Byt mapp"

#: ui/prefsadw.ui.h:53
msgid "Select new wallpaper download folder"
msgstr "Välj ny nedladdningsmapp för bakgrundsbilder"

#: ui/intervals.utils.js.h:2
msgid "on the hour"
msgstr "varje hel timme"

#: ui/intervals.utils.js.h:5
msgid "every day at midnight"
msgstr "varje dag vid midnatt"

#: ui/intervals.utils.js.h:8
msgid "Sunday at midnight"
msgstr "söndag vid midnatt"

#: ui/intervals.utils.js.h:11
msgid "User defined interval"
msgstr "Användardefinierat intervall"

#: extension.js:66
msgid "BingWallpaper extension error"
msgstr "Fel i tillägget BingWallpaper"

#: extension.js:129
msgid "<No refresh scheduled>"
msgstr "<Ingen uppdatering schemalagd>"

#: extension.js:130 extension.js:131 extension.js:139 extension.js:141
msgid "Awaiting refresh..."
msgstr "Väntar på uppdatering..."

#: extension.js:132
msgid "Open image folder"
msgstr "Öppna bildmapp"

#: extension.js:133 extension.js:149
msgid "Set background image"
msgstr "Använd som bakgrundsbild"

#: extension.js:134
msgid "Set lock screen image"
msgstr "Använd som låsskärmsbild"

#: extension.js:135
msgid "Refresh Now"
msgstr "Uppdatera nu"

#: extension.js:137
msgid "Open in image viewer"
msgstr "Öppna i bildvisare"

#: extension.js:138
msgid "Open Bing image information page"
msgstr "Öppna Bings informationssida om bilden"

#: extension.js:147
msgid "Quick settings"
msgstr "Snabbinställningar"

#: extension.js:151
msgid "Image shuffle mode"
msgstr "Blandningsläge"

#: extension.js:152
msgid "Image shuffle only favorites"
msgstr "Blanda endast favoriter"

#: extension.js:154
msgid "Show image count"
msgstr "Visa antal bilder"

#: extension.js:155
msgid "Image shuffle only UHD resolutions"
msgstr "Blanda endast bilder i UHD-upplösning"

#. Translators: %s is a date and time, followed by the time remaining in parentheses
#: extension.js:340
#, javascript-format
msgid "Next refresh: %s"
msgstr "Nästa uppdatering: %s"

#. Translators: %s is a date and time
#: extension.js:342
#, javascript-format
msgid "Last refresh: %s"
msgstr "Senaste uppdatering: %s"

#. Translators: %s is a date and time, followed by the time remaining in parentheses
#: extension.js:348
#, javascript-format
msgid "Next shuffle: %s"
msgstr "Nästa blandning: %s"

#. Translators: %s is an untranslated error message
#: extension.js:680 extension.js:697
#, javascript-format
msgid "Unable to fetch Bing metadata: %s"
msgstr "Kunde inte hämta metadata från Bing: %s"

#. Translators: %s is an untranslated error message
#: extension.js:718 extension.js:1078
#, javascript-format
msgid "Network error: %s"
msgstr "Nätverksfel: %s"

#. Translators: %s is an untranslated error message
#: extension.js:817
#, javascript-format
msgid "Unable to parse Bing metadata: %s"
msgstr "Kunde inte tolka metadata från Bing: %s"

#. Translators: %s is a date
#: extension.js:830 extension.js:919
#, javascript-format
msgid "Bing Wallpaper of the Day for %s"
msgstr "Bings dagliga bakgrundsbild för %s"

#: extension.js:957
msgid "No wallpaper available"
msgstr "Inga skrivbordsbakgrunder tillgängliga"

#: extension.js:958
msgid "No picture for today."
msgstr "Ingen bild för idag."

#. Translators: %s is a folder path
#: extension.js:1056
#, javascript-format
msgid "Download folder does not exist or is not writable: %s"
msgstr "Nedladdningsmappen finns inte eller är inte skrivbar: %s"

#. Translators: %s is a file path followed by an untranslated error message
#: extension.js:1104
#, javascript-format
msgid ""
"Image is not writable, check folder permissions or select a different "
"folder: %s"
msgstr ""
"Kan inte skriva bilden, kontrollera mappens behörigheter eller välj en annan "
"mapp: %s"

#. Translators: %s is a file path followed by an untranslated error message
#: extension.js:1112
#, javascript-format
msgid ""
"Image file error, check folder permissions, disk space or select a different "
"folder: %s"
msgstr ""
"Fel med bildfilen, kontrollera mappens behörigheter och ledigt diskutrymme, "
"eller välj en annan mapp: %s"

#: prefs.js:98
msgid "Open folder"
msgstr "Öppna mapp"

