#: ../schemas/org.gnome.shell.extensions.bingwallpaper.gschema.xml:8
msgid "Hide indicator"
msgstr "Скрыть индикатор"

#: ../schemas/org.gnome.shell.extensions.bingwallpaper.gschema.xml:9
msgid "Hide indicator icon from status area"
msgstr "Скрыть значок индикатора из области состояния"

#: ../schemas/org.gnome.shell.extensions.bingwallpaper.gschema.xml:14
msgid "Send a notifications"
msgstr "Отправлять уведомления"

#: ../schemas/org.gnome.shell.extensions.bingwallpaper.gschema.xml:15
msgid "Send a notification with explanation when a new image is available"
msgstr ""
"Показывать уведомления с подробностями после появления нового изображения"

#: ../schemas/org.gnome.shell.extensions.bingwallpaper.gschema.xml:20
msgid "Send a notifications only on most recent image"
msgstr "Отправляйте уведомления только по самому последнему изображению"

#: ../schemas/org.gnome.shell.extensions.bingwallpaper.gschema.xml:21
msgid "Notify only the most recent image, in combination with 'notify' setting"
msgstr ""
"Уведомлять только о самом последнем изображении в сочетании с настройкой "
"\"уведомлять\""

#: ../schemas/org.gnome.shell.extensions.bingwallpaper.gschema.xml:26
msgid "Use transient notifications (auto dismiss)"
msgstr "Использовать временные уведомления (автоматическое отключение)"

#: ../schemas/org.gnome.shell.extensions.bingwallpaper.gschema.xml:32
msgid "Set background"
msgstr "Установить фон"

#: ../schemas/org.gnome.shell.extensions.bingwallpaper.gschema.xml:33
msgid "Set background to Bing's background"
msgstr "Установите фон из фонов Bing"

#: ../schemas/org.gnome.shell.extensions.bingwallpaper.gschema.xml:38
msgid "Set lock screen"
msgstr "Установить экран блокировки"

#: ../schemas/org.gnome.shell.extensions.bingwallpaper.gschema.xml:39
msgid "Set lock screen to Bing's background"
msgstr "Установите экран блокировки из фонов Bing"

#: ../schemas/org.gnome.shell.extensions.bingwallpaper.gschema.xml:44
msgid "Where to download pictures."
msgstr "Где можно скачать фотографии."

#: ../schemas/org.gnome.shell.extensions.bingwallpaper.gschema.xml:50
msgid "Default Market for Bing"
msgstr "Поставщик по умолчанию для Bing"

#: ../schemas/org.gnome.shell.extensions.bingwallpaper.gschema.xml:56
msgid "Screen Size"
msgstr "Размер экрана"

#: ../schemas/org.gnome.shell.extensions.bingwallpaper.gschema.xml:57
msgid ""
"Valid sizes are '800x600', '1024x768', '1280x720', '1280x768', '1366x768', "
"'1920x1080', '1920x1200' and 'UHD'"
msgstr ""
"Допустимые размеры: \"800x600\", \"1024x768\", \"1280x720\", \"1280x768\", "
"\"1366x768\", \"1920x1080\", \"1920x1200\" и \"UHD\"."

#: ../schemas/org.gnome.shell.extensions.bingwallpaper.gschema.xml:62
msgid "Log messages to systemd journal"
msgstr "Регистрируйте сообщения в журнале systemd"

#: ../schemas/org.gnome.shell.extensions.bingwallpaper.gschema.xml:63
msgid "Unlikely to be useful for ordinary users, but helpful for debugging"
msgstr ""
"Вряд ли это будет полезно обычным пользователям, но полезно для отладки"

#: ../schemas/org.gnome.shell.extensions.bingwallpaper.gschema.xml:68
msgid "Delete previous wallpapers"
msgstr "Удалить предыдущие обои"

#: ../schemas/org.gnome.shell.extensions.bingwallpaper.gschema.xml:69
msgid "Save disk space"
msgstr "Экономить место на диске"

#: ../schemas/org.gnome.shell.extensions.bingwallpaper.gschema.xml:74
msgid "Keep previous wallpapers if they are favourites"
msgstr "Сохранять предыдущие обои, если они являются избранными"

#: ../schemas/org.gnome.shell.extensions.bingwallpaper.gschema.xml:75
msgid "Sensible default behaivour"
msgstr "Разумное поведение по умолчанию"

#: ../schemas/org.gnome.shell.extensions.bingwallpaper.gschema.xml:81
msgid "Number of days to keep wallpapers"
msgstr "Количество дней хранения обоев"

#: ../schemas/org.gnome.shell.extensions.bingwallpaper.gschema.xml:82
msgid "Delete wallpapers after this number of days"
msgstr "Удалять обои по истечении этого количества дней"

#: ../schemas/org.gnome.shell.extensions.bingwallpaper.gschema.xml:87
msgid "Replace or remove Bing watermark on high-res images"
msgstr ""
"Заменять или удалять водяной знак Bing на изображениях с высоким разрешением"

#: ../schemas/org.gnome.shell.extensions.bingwallpaper.gschema.xml:88
msgid "Set to \"none\", \"Gnome\" or \"Ubuntu\""
msgstr "Установите значение \"нет\", \"Gnome\" или \"Ubuntu\"."

#: ../schemas/org.gnome.shell.extensions.bingwallpaper.gschema.xml:93
msgid "Icon Name"
msgstr "Имя значка"

#: ../schemas/org.gnome.shell.extensions.bingwallpaper.gschema.xml:94
msgid "Icon filename to use for extension applet"
msgstr "Имя файла значка, используемого для апплета расширения"

#: ../schemas/org.gnome.shell.extensions.bingwallpaper.gschema.xml:99
msgid "Ignore Bing permitted for use as wallpaper flag"
msgstr ""
"Игнорировать флаг Bing, разрешающий для использования в качестве фонового "
"рисунка"

#: ../schemas/org.gnome.shell.extensions.bingwallpaper.gschema.xml:100
msgid "Used when wallpaper is animated, or not licensed for wallpaper use"
msgstr ""
"Используется, когда обои анимированы или не имеют лицензии на использование "
"обоев"

#: ../schemas/org.gnome.shell.extensions.bingwallpaper.gschema.xml:105
msgid "Override GNOME lockscreen (gdm3) wallpaper blur"
msgstr "Перезаписать эффекты размытия экрана блокировки GDM3"

#: ../schemas/org.gnome.shell.extensions.bingwallpaper.gschema.xml:106
msgid "Applies to GNOME 3.36 and above only"
msgstr "Применяется только к GNOME 3.36 и выше"

#: ../schemas/org.gnome.shell.extensions.bingwallpaper.gschema.xml:112
msgid "GNOME lockscreen (gdm3) wallpaper blur strength"
msgstr "Сила размытия на экране блокировки GNOME (gdm3)"

#: ../schemas/org.gnome.shell.extensions.bingwallpaper.gschema.xml:113
msgid "Degree of fuzziness"
msgstr "Степень размытости"

#: ../schemas/org.gnome.shell.extensions.bingwallpaper.gschema.xml:119
msgid "GNOME lockscreen (gdm3) wallpaper blur Brightness"
msgstr "Яркость размытия обоев на экране блокировки GNOME (gdm3)"

#: ../schemas/org.gnome.shell.extensions.bingwallpaper.gschema.xml:120
msgid "Used to darken the wallpaper to improve visibility"
msgstr "Используется для затемнения обоев для улучшения видимости"

#: ../schemas/org.gnome.shell.extensions.bingwallpaper.gschema.xml:125
msgid "Use older Bing image, select by filename"
msgstr "Используйте старое изображение Bing, выберите по имени файла"

#: ../schemas/org.gnome.shell.extensions.bingwallpaper.gschema.xml:131
msgid "Revert to showing the current image when a new one arrives"
msgstr "Вернитесь к отображению текущего изображения, когда появится новое"

#: ../schemas/org.gnome.shell.extensions.bingwallpaper.gschema.xml:132
msgid ""
"This setting may best reflect what users want from selectable or random "
"images"
msgstr ""
"Этот параметр может наилучшим образом отражать то, что пользователи хотят "
"получить от выбираемых или случайных изображений"

#: ../schemas/org.gnome.shell.extensions.bingwallpaper.gschema.xml:137
msgid ""
"Store state in JSON format so we can restore details immediately on boot"
msgstr ""
"Сохраняйте состояние в формате JSON, чтобы мы могли восстановить данные "
"сразу после загрузки"

#: ../schemas/org.gnome.shell.extensions.bingwallpaper.gschema.xml:143
msgid "Store Bing image details for rollback"
msgstr "Сохраняйте информацию об изображении Bing для отката"

#: ../schemas/org.gnome.shell.extensions.bingwallpaper.gschema.xml:149
msgid "Set to either 'daily', 'hourly', 'weekly', 'custom'"
msgstr ""
"Установите значение \"ежедневно\", \"ежечасно\", \"еженедельно\", \"по "
"желанию\""

#: ../schemas/org.gnome.shell.extensions.bingwallpaper.gschema.xml:150
msgid ""
"Daily is midnight, hourly is on the hour, weekly is midnight on Sunday, or "
"custom as defined by the 'random-interval'"
msgstr ""
"Ежедневно - в полночь, ежечасно - в зависимости от часа, еженедельно - в "
"полночь по воскресеньям или по желанию, определяемому \"случайным "
"интервалом\""

#: ../schemas/org.gnome.shell.extensions.bingwallpaper.gschema.xml:156
msgid "How frequently to change the wallpaper when on random mode"
msgstr "Как часто менять обои в случайном режиме"

#: ../schemas/org.gnome.shell.extensions.bingwallpaper.gschema.xml:162
msgid "Only pick from favourites in random mode"
msgstr "Выбирайте только из избранного в случайном режиме"

#: ../schemas/org.gnome.shell.extensions.bingwallpaper.gschema.xml:168
msgid "Pick a random image at random-interval"
msgstr "Выберите случайное изображение с произвольным интервалом"

#: ../schemas/org.gnome.shell.extensions.bingwallpaper.gschema.xml:174
msgid "Only pick from UHD in random mode"
msgstr "Выбирайте только из UHD в случайном режиме"

#: ../schemas/org.gnome.shell.extensions.bingwallpaper.gschema.xml:180
msgid "Only pick from unhidden in random mode"
msgstr "Выбирайте только из не скрытых в случайном режиме"

#: ../schemas/org.gnome.shell.extensions.bingwallpaper.gschema.xml:186
msgid "Override safe defaults for Wayland desktop"
msgstr ""
"Перезаписывать безопасные значения по-умолчанию для рабочего стола Wayland"

#: ../schemas/org.gnome.shell.extensions.bingwallpaper.gschema.xml:187
msgid ""
"Enables features which may or may not be unstable or untested in all cases"
msgstr ""
"Включать функции, которые во всех случаях могут быть нестабильными или "
"непроверенными, а могут и не быть"

#: ../schemas/org.gnome.shell.extensions.bingwallpaper.gschema.xml:192
msgid "Create thumbnails to speed up image gallery loading"
msgstr "Создавайте миниатюры, чтобы ускорить загрузку галереи изображений"

#: ../schemas/org.gnome.shell.extensions.bingwallpaper.gschema.xml:193
msgid "Speeds up subsequent loads, but requires some additional disk space"
msgstr ""
"Ускоряет последующую загрузку, но требует некоторого дополнительного места "
"на диске"

#: ../schemas/org.gnome.shell.extensions.bingwallpaper.gschema.xml:199
msgid "Minimum image height to be considered UHD"
msgstr ""
"Минимальная высота изображения, которая должна учитываться при разрешении UHD"

#: ../schemas/org.gnome.shell.extensions.bingwallpaper.gschema.xml:205
msgid "Save backup copy of Bing JSON to wallpaper directory"
msgstr "Сохраните резервную копию Bing JSON в каталоге обоев"

#: ../schemas/org.gnome.shell.extensions.bingwallpaper.gschema.xml:206
msgid "Enables migration to new install or restoration from back up"
msgstr ""
"Позволяет выполнить переход к новой установке или восстановление из "
"резервной копии"

#: ../schemas/org.gnome.shell.extensions.bingwallpaper.gschema.xml:211
msgid "Include current index and total image count in image title"
msgstr ""
"Укажите текущий индекс и общее количество изображений в заголовке изображения"

#: ../schemas/org.gnome.shell.extensions.bingwallpaper.gschema.xml:217
msgid "Size of icons for controls in popup menu"
msgstr "Размер значков элементов управления во всплывающем меню"

#: ../schemas/org.gnome.shell.extensions.bingwallpaper.gschema.xml:222
msgid "Trash deletes images or just marks as bad"
msgstr "Корзина удаляет изображения или просто помечает их как плохие"

