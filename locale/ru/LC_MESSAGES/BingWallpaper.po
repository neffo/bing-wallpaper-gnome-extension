#: ../extension.js:150
msgid "Awaiting refresh..."
msgstr "Ожидание обновления..."

#: ../extension.js:139
msgid "Copy image to clipboard"
msgstr "Скопировать в буфер обмена"

#: ../extension.js:140
msgid "Copy image URL to clipboard"
msgstr "Скопировать URL в буфер"

#: ../extension.js:141
msgid "Open image folder"
msgstr "Открыть папку изображений"

#: ../extension.js:142 ../extension.js:158
msgid "Set background image"
msgstr "Установить фоновое изображение"

#: ../extension.js:143
msgid "Set lock screen image"
msgstr "Установить изображение экрана блокировки"

#: ../extension.js:144
msgid "Refresh Now"
msgstr "Обновить сейчас"

#: ../extension.js:145
msgid "Settings"
msgstr "Настройки"

#: ../extension.js:146
msgid "Open in image viewer"
msgstr "Открыть в программе просмотра изображений"

#: ../extension.js:147
msgid "Open Bing image information page"
msgstr "Открыть в Bing страницу с информацией об изображении"

#: ../extension.js:156
msgid "Quick settings"
msgstr "Быстрые настройки"

#: ../extension.js:159
msgid "Always show new images"
msgstr "Всегда показывать новые изображения"

#: ../extension.js:160
msgid "Image shuffle mode"
msgstr "Режим случайных изображений"

#: ../extension.js:161
msgid "Image shuffle only favorites"
msgstr "Перемешивать только избранные изображения"

#: ../extension.js:163
msgid "Show image count"
msgstr "Показать количество изображений"

#: ../extension.js:164
msgid "Image shuffle only UHD resolutions"
msgstr "Перемешивать только UHD изображения"

#: ../extension.js:360
msgid "Next refresh"
msgstr "Следующее обновление"

#: ../extension.js:362
msgid "Last refresh"
msgstr "Последнее обновление"

#: ../extension.js:365
msgid "Next shuffle"
msgstr "Следующее перемешивание"

#: ../extension.js:858 ../extension.js:946
msgid "Bing Wallpaper of the Day for"
msgstr "Изображение дня Bing Wallpaper для"

#: ../extension.js:984
msgid "No wallpaper available"
msgstr "Нет доступных обоев"

#: ../extension.js:985
msgid "No picture for today."
msgstr "Нет изображения дня."

#: ../prefs.js:107
msgid "Open folder"
msgstr "Открыть папку"

#: ../prefs.js:112
msgid "Change folder"
msgstr "Изменить папку"

#: ../prefs.js:124
msgid "Default"
msgstr "По умолчанию"

#: ../prefs.js:129
msgid "No blur, slight dim"
msgstr "Без размытия, незначительное затемнение"

#: ../prefs.js:134
msgid "Slight blur & dim"
msgstr "Незначительное размытие и затемнение"

#: ../prefs.js:148
msgid "Import"
msgstr "Импортировать"

#: ../prefs.js:153
msgid "Export"
msgstr "Экспортировать"

#: ../prefs.js:221
msgid "Select wallpaper download folder"
msgstr "Выберите папку для загрузки обоев"

#: ../utils.js:142
msgid "Error fetching change log: "
msgstr "Ошибка при выборке журнала изменений: "

