#: ui/prefsadw.ui.h:12
msgid "Set wallpaper"
msgstr "Hintergrundbild festlegen"

#: ui/prefsadw.ui.h:13
msgid "Whether to set wallpaper automatically"
msgstr "Ob das Hintergrundbild automatisch festgelegt werden soll"

#: ui/prefsadw.ui.h:14
msgid "Shuffle wallpaper"
msgstr "Hintergrundbild zufällig wechseln"

#: ui/prefsadw.ui.h:15
msgid "Randomly select wallpaper from collection"
msgstr "Zufällige Auswahl eines Hintergrundbilds aus der Sammlung"

#: ui/prefsadw.ui.h:16
msgid "Shuffle interval"
msgstr "Wechselintervall"

#: ui/prefsadw.ui.h:17
msgid "How frequently to shuffle wallpapers"
msgstr "Wie oft Hintergrundbilder wechseln"

#: ui/prefsadw.ui.h:18
msgid "Downloads"
msgstr "Downloads"

#: ui/prefsadw.ui.h:19
msgid "Debug"
msgstr "Debug"

#: ui/prefsadw.ui.h:20
msgid "Debug options"
msgstr "Debug-Einstellungen"

#: ui/prefsadw.ui.h:21
msgid "Debug logging"
msgstr "Debug-Protokollierung"

#: ui/prefsadw.ui.h:22
msgid "Enable logging to system journal"
msgstr "Protokollierung in System-Journal aktivieren"

#: ui/prefsadw.ui.h:23
msgid "Advanced options"
msgstr "Erweiterte Einstellungen"

#: ui/prefsadw.ui.h:24 extension.js:150
msgid "Always show new images"
msgstr "Neue Bilder immer anzeigen"

#: ui/prefsadw.ui.h:25
msgid "Switch to new images when available (unless on random mode)"
msgstr ""
"Zu neuen Bildern wechseln, sobald diese verfügbar sind (außer im "
"Zufallsmodus)"

#: ui/prefsadw.ui.h:26
msgid "Purge on trash"
msgstr "Beim Löschen aufräumen"

#: ui/prefsadw.ui.h:27
msgid "Trashing an image will remove it from database and disk"
msgstr ""
"Das Verschieben eines Bildes in den Papierkorb entfernt es aus der Datenbank "
"und von der Festplatte."

#: ui/prefsadw.ui.h:28
msgid "Screen resolution"
msgstr "Bildschirmauflösung"

#: ui/prefsadw.ui.h:29
msgid "Override automatic resolution selection"
msgstr "Automatische Auswahl der Auflösung überschreiben"

#: ui/prefsadw.ui.h:30
msgid "Random interval"
msgstr "Zufallsintervall"

#: ui/prefsadw.ui.h:31
msgid "Custom shuffle interval when enabled"
msgstr "Benutzerdefiniertes Zufallsintervall bei Aktivierung"

#: ui/prefsadw.ui.h:32
msgid "Delete older images"
msgstr "Ältere Bilder löschen"

#: ui/prefsadw.ui.h:33
msgid "Automatically delete older images (excludes favourites)"
msgstr "Ältere Bilder automatisch löschen (ausgenommen Favoriten)"

#: ui/prefsadw.ui.h:34
msgid "Number of days to keep images"
msgstr "Anzahl der Tage, für die Bilder aufbewahrt werden"

#: ui/prefsadw.ui.h:35
msgid "Keep images for this number of days (favourites are kept forever)"
msgstr ""
"Bilder für diese Anzahl an Tagen behalten (Favoriten werden dauerhaft "
"gespeichert)"

