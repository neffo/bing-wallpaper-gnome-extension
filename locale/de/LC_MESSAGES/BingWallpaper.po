#: ui/prefsadw.ui.h:1 extension.js:136
msgid "Settings"
msgstr "Einstellungen"

#: ui/prefsadw.ui.h:2
msgid "Indicator"
msgstr "Taskleistensymbol"

#: ui/prefsadw.ui.h:3
msgid "Hide Indicator"
msgstr "Taskleistensymbol ausblenden"

#: ui/prefsadw.ui.h:4
msgid "Whether to hide the panel indicator"
msgstr "Ob das Taskleistensymbol ausgeblendet werden soll"

#: ui/prefsadw.ui.h:5
msgid "Desktop notifications"
msgstr "Desktop-Benachrichtigungen"

#: ui/prefsadw.ui.h:6
msgid "Enable notifications on new images"
msgstr "Desktop-Benachrichtigungen bei neuen Bildern aktivieren"

#: ui/prefsadw.ui.h:7
msgid "Indicator icon"
msgstr "Taskleistensymbol"

#: ui/prefsadw.ui.h:8
msgid "Select from alternate tray icons"
