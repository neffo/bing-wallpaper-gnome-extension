#: ui/prefsadw.ui.h:1 extension.js:136
msgid "Settings"
msgstr "Innstillinger"

#: ui/prefsadw.ui.h:2
msgid "Indicator"
msgstr "Indikatorikon"

#: ui/prefsadw.ui.h:3
msgid "Hide Indicator"
msgstr "Skjul indikatoren"

#: ui/prefsadw.ui.h:4
msgid "Whether to hide the panel indicator"
msgstr "Om panelindikatoren skal skjules"

#: ui/prefsadw.ui.h:5
msgid "Desktop notifications"
msgstr "Skrivebordsvarsler"

#: ui/prefsadw.ui.h:6
msgid "Enable notifications on new images"
msgstr "Aktiver varsler på nye bilder"

#: ui/prefsadw.ui.h:7
msgid "Indicator icon"
msgstr "Indikatorikon"

#: ui/prefsadw.ui.h:8
msgid "Select from alternate tray icons"
msgstr "Velg fra alternative ikoner"

#: ui/prefsadw.ui.h:9
msgid "Wallpaper"
msgstr "Tapet"

#: ui/prefsadw.ui.h:10
msgid "Set wallpaper"
msgstr "Sett tapet"

#: ui/prefsadw.ui.h:11
msgid "Whether to set wallpaper automatically"
msgstr "Om du vil sette tapet automatisk"

#: ui/prefsadw.ui.h:12
msgid "Shuffle wallpaper"
msgstr "Stokk tapet"

#: ui/prefsadw.ui.h:13
msgid "Randomly select wallpaper from collection"
msgstr "Velg tilfeldig tapet fra samlingen"

#: ui/prefsadw.ui.h:14
msgid "Shuffle interval"
msgstr "Stokkeintervall"

#: ui/prefsadw.ui.h:15
msgid "How frequently to shuffle wallpapers"
msgstr "Hvor ofte tapet stokkes"

#: ui/prefsadw.ui.h:16
msgid "Downloads"
msgstr "Nedlastinger"

#: ui/prefsadw.ui.h:17
msgid "Download folder"
msgstr "Nedlastingsmappe"

#: ui/prefsadw.ui.h:18
msgid "Open or change wallpaper downloads folder"
msgstr "Åpne eller endre mappen for nedlasting av bakgrunnsbilder"

#: ui/prefsadw.ui.h:19
msgid "Debug"
msgstr "Feilsøk"

#: ui/prefsadw.ui.h:20
msgid "Debug options"
msgstr "Alternativer for feilsøk"

#: ui/prefsadw.ui.h:21
msgid "Debug logging"
msgstr "Logging av feilsøk"

#: ui/prefsadw.ui.h:22
msgid "Enable logging to system journal"
msgstr "Aktiver logging til systemjournal"

#: ui/prefsadw.ui.h:23
msgid "Advanced options"
msgstr "Avanserte alternativer"

#: ui/prefsadw.ui.h:24 extension.js:150
msgid "Always show new images"
msgstr "Alltid vis nye bilder"

#: ui/prefsadw.ui.h:25
msgid "Switch to new images when available (unless on random mode)"
msgstr ""
"Bytt til nye bilder når de er tilgjengelige (med mindre i tilfeldig modus)"

#: ui/prefsadw.ui.h:26
msgid "Purge on trash"
msgstr "Slett ved kast"

#: ui/prefsadw.ui.h:27
msgid "Trashing an image will remove it from database and disk"
msgstr "Hvis du sletter et bilde, fjernes det fra databasen og disken"

#: ui/prefsadw.ui.h:28
msgid "Screen resolution"
msgstr "Skjermoppløsning"

#: ui/prefsadw.ui.h:29
msgid "Override automatic resolution selection"
msgstr "Overstyr automatisk valg av skjermoppløsning"

#: ui/prefsadw.ui.h:30
msgid "Random interval"
msgstr "Tilfeldig intervall"

#: ui/prefsadw.ui.h:31 ui/prefsadw.ui.h:39
msgid "Custom shuffle interval when enabled"
msgstr "Eget stokke-intervall når aktivert"

#: ui/prefsadw.ui.h:32
msgid "Delete older images"
msgstr "Slett eldre bilde"

#: ui/prefsadw.ui.h:33
msgid "Automatically delete older images (excludes favourites)"
msgstr "Slett automatisk eldre bilder (ekskluderer favoritter)"

#: ui/prefsadw.ui.h:34
msgid "Number of days to keep images"
msgstr "Antall dager bilder beholdes"

#: ui/prefsadw.ui.h:35
msgid "Keep images for this number of days (favourites are kept forever)"
msgstr "Behold bilder i dette antallet dager (favoritter beholdes for alltid)"

#: ui/prefsadw.ui.h:36
msgid "Always export Bing data"
msgstr "Eksporter alltid Bing-data"

#: ui/prefsadw.ui.h:37
msgid "Export Bing JSON when image data changes"
msgstr "Eksporter Bing JSON når bildedata endres"

#: ui/prefsadw.ui.h:38
msgid "Bing JSON data"
msgstr "Bing JSON-data"

#: ui/prefsadw.ui.h:40
msgid "About"
msgstr "Om"

#: ui/prefsadw.ui.h:41
msgid "Bing Wallpaper"
msgstr "Bing-tapet"

#: ui/prefsadw.ui.h:42
msgid "New wallpaper images everyday from Bing"
msgstr "Nye tapet-bilder hver dag fra Bing"

#: ui/prefsadw.ui.h:43
msgid "Maintained by Michael Carroll"
msgstr "Vedlikeholdes av Michael Carroll"

#: ui/prefsadw.ui.h:44
msgid "Version"
msgstr "Versjon"

#: ui/prefsadw.ui.h:45
msgid "Release notes"
msgstr "Utgivelsesnotater"

#: ui/prefsadw.ui.h:46
msgid "GNOME extensions page"
msgstr "Side for GNOME-utvidelser"

#: ui/prefsadw.ui.h:47
msgid "Source code"
msgstr "Kildekode"

#: ui/prefsadw.ui.h:48
msgid "Report an issue"
msgstr "Rapporter et problem"

#: ui/prefsadw.ui.h:49
msgid "Contributors"
msgstr "Bidragsytere"

#: ui/prefsadw.ui.h:50
msgid "License"
msgstr "Lisens"

#: ui/prefsadw.ui.h:51
msgid ""
"This extension is free software: you can redistribute it and/or modify it "
"under the terms of the GNU Lesser General Public License as published by the "
"Free Software Foundation, either version 3 of the License, or (at your "
"option) any later version."
msgstr ""
"Denne utvidelsen er fri programvare: Du kan videredistribuere den og/eller "
"endre den under vilkårene i GNU Lesser General Public License, utgitt av "
"Free Software Foundation, enten versjon 3 av lisensen eller (etter eget "
"valg) en senere versjon."

#: ui/prefsadw.ui.h:52 prefs.js:103
msgid "Change folder"
msgstr "Endre mappe"

#: ui/prefsadw.ui.h:53
msgid "Select new wallpaper download folder"
msgstr "Velg ny mappe for nedlasting av tapet"

# Seems like a patchwork message.
#: ui/intervals.utils.js.h:2
msgid "on the hour"
msgstr "på timen"

# Seems like a patchwork message.
#: ui/intervals.utils.js.h:5
msgid "every day at midnight"
msgstr "hver dag ved midnatt"

#: ui/intervals.utils.js.h:8
msgid "Sunday at midnight"
msgstr "Søndag ved midnatt"

#: ui/intervals.utils.js.h:11
msgid "User defined interval"
msgstr "Brukerdefinert intervall"

#: extension.js:66
msgid "BingWallpaper extension error"
msgstr "Feil i BingWallpaper-utvidelsen"

#: extension.js:129
msgid "<No refresh scheduled>"
msgstr "<Ingen oppdatering planlagt>"

#: extension.js:130 extension.js:131 extension.js:139 extension.js:141
msgid "Awaiting refresh..."
msgstr "Venter på oppdatering …"

#: extension.js:132
msgid "Open image folder"
msgstr "Åpne billedmappe"

#: extension.js:133 extension.js:149
msgid "Set background image"
msgstr "Sett bakgrunnsbilde"

#: extension.js:134
msgid "Set lock screen image"
msgstr "Sett låseskjermbilde"

#: extension.js:135
msgid "Refresh Now"
msgstr "Oppdater nå"

#: extension.js:137
msgid "Open in image viewer"
msgstr "Åpne i bildeviser"

#: extension.js:138
msgid "Open Bing image information page"
msgstr "Åpne Bing sin informasjonsside om bildet"

#: extension.js:147
msgid "Quick settings"
msgstr "Raske innstillinger"

#: extension.js:151
msgid "Image shuffle mode"
msgstr "Stokket bildemodus"

#: extension.js:152
msgid "Image shuffle only favorites"
msgstr "Stokk bare favoritt-bilder"

#: extension.js:154
msgid "Show image count"
msgstr "Vis antall bilder"

#: extension.js:155
msgid "Image shuffle only UHD resolutions"
msgstr "Stokk bare bilder med UHD-oppløsning"

#. Translators: %s is a date and time, followed by the time remaining in parentheses
#: extension.js:340
#, javascript-format
msgid "Next refresh: %s"
msgstr "Neste oppdatering: %s"

#. Translators: %s is a date and time
#: extension.js:342
#, javascript-format
msgid "Last refresh: %s"
msgstr "Siste oppdatering: %s"

#. Translators: %s is a date and time, followed by the time remaining in parentheses
#: extension.js:348
#, javascript-format
msgid "Next shuffle: %s"
msgstr "Neste stokking: %s"

#. Translators: %s is an untranslated error message
#: extension.js:680 extension.js:697
#, javascript-format
msgid "Unable to fetch Bing metadata: %s"
msgstr "Kunne ikke hente metadata fra Bing: %s"

#. Translators: %s is an untranslated error message
#: extension.js:718 extension.js:1078
#, javascript-format
msgid "Network error: %s"
msgstr "Nettverksfeil: %s"

#. Translators: %s is an untranslated error message
#: extension.js:817
#, javascript-format
msgid "Unable to parse Bing metadata: %s"
msgstr "Kunne ikke tolke metadata fra Bing: %s"

#. Translators: %s is a date
#: extension.js:830 extension.js:919
#, javascript-format
msgid "Bing Wallpaper of the Day for %s"
msgstr "Dagens Bing-tapet for %s"

#: extension.js:957
msgid "No wallpaper available"
msgstr "Ingen bakgrunnsbilde tilgjengelig"

#: extension.js:958
msgid "No picture for today."
msgstr "Ikke noe bilde for i dag."

#. Translators: %s is a folder path
#: extension.js:1056
#, javascript-format
msgid "Download folder does not exist or is not writable: %s"
msgstr "Nedlastingsmappen finnes ikke eller kan ikke skrives til: %s"

#. Translators: %s is a file path followed by an untranslated error message
#: extension.js:1104
#, javascript-format
msgid ""
"Image is not writable, check folder permissions or select a different "
"folder: %s"
msgstr ""
"Kan ikke skrive bildet, sjekk tilgangene til mappen eller velg en annen "
"mappe: %s"

#. Translators: %s is a file path followed by an untranslated error message
#: extension.js:1112
#, javascript-format
msgid ""
"Image file error, check folder permissions, disk space or select a different "
"folder: %s"
msgstr ""
"Feil med bildefilen, sjekk tilgangene til mappen og ledig diskplass, eller "
"velg en annen mappe: %s"

#: prefs.js:98
msgid "Open folder"
msgstr "Åpne mappe"

