#: utils.js:412
#, javascript-format
msgid "%d d"
msgstr "%d d"

#: utils.js:412
#, javascript-format
msgid "%d day"
msgid_plural "%d days"
msgstr[0] "%d dag"
msgstr[1] "%d dagar"

#. Translators: %d is a number of hours, the short form should be about 4-5 characters
#: utils.js:417
#, javascript-format
msgid "%d h"
msgstr "%d t"

