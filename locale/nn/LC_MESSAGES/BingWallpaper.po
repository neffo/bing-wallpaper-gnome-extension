#: ui/prefsadw.ui.h:1 extension.js:136
msgid "Settings"
msgstr "Innstillingar"

#: ui/prefsadw.ui.h:2
msgid "Indicator"
msgstr "Indikator"

#: ui/prefsadw.ui.h:3
msgid "Hide Indicator"
msgstr "Skjul indikatoren"

#: ui/prefsadw.ui.h:4
msgid "Whether to hide the panel indicator"
msgstr "Om indikatoren i panelet skal skjulast"

#: ui/prefsadw.ui.h:5
msgid "Desktop notifications"
msgstr "Skrivebordsvarsel"

#: ui/prefsadw.ui.h:6
msgid "Enable notifications on new images"
msgstr "Slå på varsel om nye bilete"

#: ui/prefsadw.ui.h:7
msgid "Indicator icon"
msgstr "Indikatorikon"

#: ui/prefsadw.ui.h:8
msgid "Select from alternate tray icons"
msgstr "Vel mellom alternative ikon"

#: ui/prefsadw.ui.h:9
msgid "Wallpaper"
msgstr "Bakgrunnsbilete"

#: ui/prefsadw.ui.h:10
msgid "Set wallpaper"
msgstr "Sett bakgrunnsbilete"

#: ui/prefsadw.ui.h:11
msgid "Whether to set wallpaper automatically"
msgstr "Om bakgrunnsbiletet skal setjast automatisk"

#: ui/prefsadw.ui.h:12
msgid "Shuffle wallpaper"
msgstr "Stokk bakgrunnsbilete"

#: ui/prefsadw.ui.h:13
msgid "Randomly select wallpaper from collection"
msgstr "Vel bakgrunnsbilete tilfeldig frå samlinga"

#: ui/prefsadw.ui.h:14
msgid "Shuffle interval"
msgstr "Stokkeintervall"

#: ui/prefsadw.ui.h:15
msgid "How frequently to shuffle wallpapers"
msgstr "Kor ofte bakgrunnsbileta skal stokkast"

#: ui/prefsadw.ui.h:16
msgid "Downloads"
msgstr "Nedlastingar"

#: ui/prefsadw.ui.h:17
msgid "Download folder"
msgstr "Nedlastingsmappe"

#: ui/prefsadw.ui.h:18
msgid "Open or change wallpaper downloads folder"
msgstr "Opne eller endra mappa for nedlasta bakgrunnsbilete"

#: ui/prefsadw.ui.h:19
msgid "Debug"
msgstr "Feilsøking"

#: ui/prefsadw.ui.h:20
msgid "Debug options"
msgstr "Val for feilsøking"

#: ui/prefsadw.ui.h:21
msgid "Debug logging"
msgstr "Feilsøkingslogg"

#: ui/prefsadw.ui.h:22
msgid "Enable logging to system journal"
msgstr "Slå på logging til systemjournalen"

#: ui/prefsadw.ui.h:23
msgid "Advanced options"
msgstr "Avanserte val"

#: ui/prefsadw.ui.h:24 extension.js:150
msgid "Always show new images"
msgstr "Vis alltid nye bilete"

#: ui/prefsadw.ui.h:25
msgid "Switch to new images when available (unless on random mode)"
msgstr ""
"Byt til nye bilete når dei er tilgjengelege (med mindre tilfeldig modus er "
"på)"

#: ui/prefsadw.ui.h:26
msgid "Purge on trash"
msgstr "Slett ved kasting"

#: ui/prefsadw.ui.h:27
msgid "Trashing an image will remove it from database and disk"
msgstr "Når du kastar eit bilete, blir det fjerna frå databasen og disken"

#: ui/prefsadw.ui.h:28
msgid "Screen resolution"
msgstr "Skjermoppløysing"

#: ui/prefsadw.ui.h:29
msgid "Override automatic resolution selection"
msgstr "Overstyr automatisk val av skjermoppløysing"

#: ui/prefsadw.ui.h:30
msgid "Random interval"
msgstr "Tilfeldig intervall"

#: ui/prefsadw.ui.h:31 ui/prefsadw.ui.h:39
msgid "Custom shuffle interval when enabled"
msgstr "Eige stokkeintervall når det er slått på"

#: ui/prefsadw.ui.h:32
msgid "Delete older images"
msgstr "Slett eldre bilete"

#: ui/prefsadw.ui.h:33
msgid "Automatically delete older images (excludes favourites)"
msgstr "Slett eldre bilete automatisk (gjeld ikkje favorittar)"

#: ui/prefsadw.ui.h:34
msgid "Number of days to keep images"
msgstr "Tal på dagar bileta skal takast vare på"

#: ui/prefsadw.ui.h:35
msgid "Keep images for this number of days (favourites are kept forever)"
msgstr ""
"Ta vare på bileta i så mange dagar (favorittar blir tekne vare på for alltid)"

#: ui/prefsadw.ui.h:36
msgid "Always export Bing data"
msgstr "Eksporter alltid Bing-data"

#: ui/prefsadw.ui.h:37
msgid "Export Bing JSON when image data changes"
msgstr "Eksporter Bing-JSON når biletdata endrar seg"

#: ui/prefsadw.ui.h:38
msgid "Bing JSON data"
msgstr "Bing JSON-data"

#: ui/prefsadw.ui.h:40
msgid "About"
msgstr "Om"

#: ui/prefsadw.ui.h:41
msgid "Bing Wallpaper"
msgstr "Bing-bakgrunnsbilete"

#: ui/prefsadw.ui.h:42
msgid "New wallpaper images everyday from Bing"
msgstr "Nye bakgrunnsbilete frå Bing kvar dag"

#: ui/prefsadw.ui.h:43
msgid "Maintained by Michael Carroll"
msgstr "Haldast ved like av Michael Carroll"

#: ui/prefsadw.ui.h:44
msgid "Version"
msgstr "Versjon"

#: ui/prefsadw.ui.h:45
msgid "Release notes"
msgstr "Utgjevingsnotat"

#: ui/prefsadw.ui.h:46
msgid "GNOME extensions page"
msgstr "Sida for GNOME-utvidingar"

#: ui/prefsadw.ui.h:47
msgid "Source code"
msgstr "Kjeldekode"

#: ui/prefsadw.ui.h:48
msgid "Report an issue"
msgstr "Rapporter eit problem"

#: ui/prefsadw.ui.h:49
msgid "Contributors"
msgstr "Bidragsytarar"

#: ui/prefsadw.ui.h:50
msgid "License"
msgstr "Lisens"

#: ui/prefsadw.ui.h:51
msgid ""
"This extension is free software: you can redistribute it and/or modify it "
"under the terms of the GNU Lesser General Public License as published by the "
"Free Software Foundation, either version 3 of the License, or (at your "
"option) any later version."
msgstr ""
"Denne utvidinga er fri programvare: Du kan vidaredistribuere ho og/eller "
"endre ho under vilkåra i GNU Lesser General Public License, utgjeven av Free "
"Software Foundation, anten versjon 3 av lisensen eller (etter eige val) ein "
"seinare versjon."

#: ui/prefsadw.ui.h:52 prefs.js:103
msgid "Change folder"
msgstr "Endra mappe"

#: ui/prefsadw.ui.h:53
msgid "Select new wallpaper download folder"
msgstr "Vel ny mappe for nedlasting av bakgrunnsbilete"

#: ui/intervals.utils.js.h:2
msgid "on the hour"
msgstr "kvar heile time"

#: ui/intervals.utils.js.h:5
msgid "every day at midnight"
msgstr "kvar dag ved midnatt"

#: ui/intervals.utils.js.h:8
msgid "Sunday at midnight"
msgstr "søndag ved midnatt"

#: ui/intervals.utils.js.h:11
msgid "User defined interval"
msgstr "Brukardefinert intervall"

#: extension.js:66
msgid "BingWallpaper extension error"
msgstr "Feil i BingWallpaper-utvidinga"

#: extension.js:129
msgid "<No refresh scheduled>"
msgstr "<Inga oppdatering planlagt>"

#: extension.js:130 extension.js:131 extension.js:139 extension.js:141
msgid "Awaiting refresh..."
msgstr "Ventar på oppdatering …"

#: extension.js:132
msgid "Open image folder"
msgstr "Opne biletmappa"

#: extension.js:133 extension.js:149
msgid "Set background image"
msgstr "Sett bakgrunnsbilete"

#: extension.js:134
msgid "Set lock screen image"
msgstr "Sett låseskjermbilete"

#: extension.js:135
msgid "Refresh Now"
msgstr "Oppdater no"

#: extension.js:137
msgid "Open in image viewer"
msgstr "Opne i biletvisar"

#: extension.js:138
msgid "Open Bing image information page"
msgstr "Opne Bing-sida med informasjon om biletet"

#: extension.js:147
msgid "Quick settings"
msgstr "Snøgginnstillingar"

#: extension.js:151
msgid "Image shuffle mode"
msgstr "Stokkemodus"

#: extension.js:152
msgid "Image shuffle only favorites"
msgstr "Stokk berre favorittbilete"

#: extension.js:154
msgid "Show image count"
msgstr "Vis talet på bilete"

#: extension.js:155
msgid "Image shuffle only UHD resolutions"
msgstr "Stokk berre bilete med UHD-oppløysing"

#. Translators: %s is a date and time, followed by the time remaining in parentheses
#: extension.js:340
#, javascript-format
msgid "Next refresh: %s"
msgstr "Neste oppdatering: %s"

#. Translators: %s is a date and time
#: extension.js:342
#, javascript-format
msgid "Last refresh: %s"
msgstr "Siste oppdatering: %s"

#. Translators: %s is a date and time, followed by the time remaining in parentheses
#: extension.js:348
#, javascript-format
msgid "Next shuffle: %s"
msgstr "Neste stokking: %s"

#. Translators: %s is an untranslated error message
#: extension.js:680 extension.js:697
#, javascript-format
msgid "Unable to fetch Bing metadata: %s"
msgstr "Klarte ikkje å hente metadata frå Bing: %s"

#. Translators: %s is an untranslated error message
#: extension.js:718 extension.js:1078
#, javascript-format
msgid "Network error: %s"
msgstr "Nettverksfeil: %s"

#. Translators: %s is an untranslated error message
#: extension.js:817
#, javascript-format
msgid "Unable to parse Bing metadata: %s"
msgstr "Klarte ikkje å tolke metadata frå Bing: %s"

#. Translators: %s is a date
#: extension.js:830 extension.js:919
#, javascript-format
msgid "Bing Wallpaper of the Day for %s"
msgstr "Dagens Bing-bakgrunnsbilete for %s"

#: extension.js:957
msgid "No wallpaper available"
msgstr "Ingen bakgrunn tilgjengeleg"

#: extension.js:958
msgid "No picture for today."
msgstr "Ikkje noko bilete for i dag."

#. Translators: %s is a folder path
#: extension.js:1056
#, javascript-format
msgid "Download folder does not exist or is not writable: %s"
msgstr "Nedlastingsmappa finst ikkje eller kan ikkje skrivast til: %s"

#. Translators: %s is a file path followed by an untranslated error message
#: extension.js:1104
#, javascript-format
msgid ""
"Image is not writable, check folder permissions or select a different "
"folder: %s"
msgstr ""
"Kan ikkje skrive biletet, sjekk tilgangane til mappa eller vel ei anna "
"mappe: %s"

#. Translators: %s is a file path followed by an untranslated error message
#: extension.js:1112
#, javascript-format
msgid ""
"Image file error, check folder permissions, disk space or select a different "
"folder: %s"
msgstr ""
"Feil med biletfila, sjekk tilgangane til mappa og ledig diskplass, eller vel "
"ei anna mappe: %s"

#: prefs.js:98
msgid "Open folder"
msgstr "Opne mappa"

#: prefs.js:115
msgid "Import"
msgstr "Import"

#: prefs.js:120
msgid "Export"
msgstr "Eksport"

#: prefs.js:183
msgid "Select"
msgstr "Vel"

#: prefs.js:185
msgid "Select wallpaper download folder"
msgstr "Vel nedlastingsmappe for bakgrunnsbilete"

